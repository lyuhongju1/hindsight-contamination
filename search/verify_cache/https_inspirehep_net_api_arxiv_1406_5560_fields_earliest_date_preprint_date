d6cbb0c4d","url":"https://inspirehep.net/files/a6ecbf9eeb79de99fdb9ce2d6cbb0c4d","source":"arxiv","caption":"\\scriptsize \\sf  Schematic views of the cryo-purification system: Front view [top], Top view [bottom]. The ArgoNeuT cryostat, the liquid argon pump and filter for oxygen and water removal are part of the skid.","filename":"Figure20b.png"},{"key":"66ff364c6721812989f9c57f189bd0f9","url":"https://inspirehep.net/files/66ff364c6721812989f9c57f189bd0f9","source":"arxiv","caption":"\\scriptsize \\sf Fraction of charged pion energy contained in liquid argon as a function of longitudinal [Top] and transverse [Bot] distance from its starting position.","filename":"Figure21a.png"},{"key":"92bf01b812178e4e9c0cbf93011aa8d2","url":"https://inspirehep.net/files/92bf01b812178e4e9c0cbf93011aa8d2","source":"arxiv","caption":"\\scriptsize \\sf Fraction of charged pion energy contained in liquid argon as a function of longitudinal [Top] and transverse [Bot] distance from its starting position.","filename":"Figure21b.png"}],"license":[{"url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","imposing":"arXiv"}],"texkeys":["Cavanna:2014iqa"],"citeable":true,"keywords":[{"value":"time projection chamber: liquid argon","schema":"INSPIRE"},{"value":"neutrino: oscillation","schema":"INSPIRE"},{"value":"calibration","schema":"INSPIRE"},{"value":"booster","schema":"INSPIRE"},{"value":"Fermilab","schema":"INSPIRE"}],"abstracts":[{"value":"Liquid Argon Time Projection Chambers (LArTPCs) are ideal detectors for precision neutrino physics. These detectors, when located deep underground, can also be used for measurements of proton decay, and astrophysical neutrinos. The technology must be completely developed, up to very large mass scales, and fully mastered to construct and operate these detectors for this physics program. As part of an integrated plan of developing these detectors, accurate measurements in LArTPC of known particle species in the relevant energy ranges are now deemed as necessary. The LArIAT program aims to directly achieve these goals by deploying LArTPC detectors in a dedicated calibration test beam line at Fermilab. The set of measurements envisaged here are significant for both the short-baseline (SBN) and long-baseline (LBN) neutrino oscillation programs in the US, starting with MicroBooNE in the near term and with the adjoint near and far liquid argon detectors in the Booster beam line at Fermilab envisioned in the mid-term, and moving towards deep underground physics such as with the long-baseline neutrino facility (LBNF) in the longer term.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/661854"},"reference":{"misc":["Icarus Collaboration Design, construction and tests of the ICARUS T600 detector, Nucl. Instr. and Meth. in Phys. Res. A 527 , 329"],"label":"1","authors":[{"full_name":"Amerio, S."}],"publication_info":{"year":2004,"artid":"329","page_start":"329","journal_title":"Nucl.Instrum.Meth.A","journal_volume":"527"}},"legacy_curated":true,"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/912685"},"reference":{"misc":["Icarus Collaboration Underground operation of the ICARUS T600 LAr-TPC: first results"],"label":"2","authors":[{"full_name":"Rubbia, C."}],"publication_info":{"year":2011,"artid":"P07011","journal_title":"JINST","journal_volume":"6"}},"legacy_curated":true,"curated_relation":false},{"reference":{"misc":["ArgoNeuT Collaboration T962: ArgoNeuT (Argon Neutrino Test) Mini Liquid Argon TPC in the NuMI Beam"],"urls":[{"value":"http://t962.fnal.gov"}],"label":"3","authors":[{"full_name":"Fleming, B.T."}]}},{"reference":{"misc":["MicroBooNE Collaboration Proposal for a New Experiment Using the Booster and NuMI Neutrino Beamlines: MicroBooNE -PROPOSAL-0974"],"label":"4","authors":[{"full_name":"Chen, H."}],"imprint":{"publisher":"Fermilab"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/943406"},"reference":{"misc":["LBNE C