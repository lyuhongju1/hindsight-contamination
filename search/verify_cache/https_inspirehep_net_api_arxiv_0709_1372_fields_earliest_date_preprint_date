sa"}]},{"uuid":"9b7cf0c6-b2ef-46b9-a5c8-770a34a78060","record":{"$ref":"https://inspirehep.net/api/authors/1040993"},"full_name":"Pareschi, Giovanni","signature_block":"PARASg","raw_affiliations":[{"value":"Osservatorio Astronomico di Brera"}]},{"uuid":"a5713b6b-7190-403d-a9fc-a150457d881d","record":{"$ref":"https://inspirehep.net/api/authors/994145"},"full_name":"Pascoli, Donatella","signature_block":"PASCALd","raw_affiliations":[{"value":"INFN di Padova"}]},{"uuid":"d128c338-f53b-48d3-a716-772b8ee0721d","record":{"$ref":"https://inspirehep.net/api/authors/993846"},"full_name":"Pepato, Adriano","signature_block":"PAPATa","raw_affiliations":[{"value":"INFN di Padova"}]},{"uuid":"842c484d-0920-4cdb-9b71-1bc25486e516","record":{"$ref":"https://inspirehep.net/api/authors/1026804"},"full_name":"Peruzzo, Luigi","signature_block":"PARASl","raw_affiliations":[{"value":"INFN di Padova"}]},{"uuid":"a4cef5ab-5ae1-48a6-9744-c9ce0fc36dac","record":{"$ref":"https://inspirehep.net/api/authors/1026813"},"full_name":"Saggion, Antonio","signature_block":"SAGANa","raw_affiliations":[{"value":"Università di Padova"}]},{"uuid":"846951ef-4bb5-4b8a-988d-3f71eea4f02b","record":{"$ref":"https://inspirehep.net/api/authors/990278"},"full_name":"Sartori, Paolo","signature_block":"SARTARp","raw_affiliations":[{"value":"INFN di Padova"}]},{"uuid":"08d33017-26f8-4316-b4db-6de9d59344c3","record":{"$ref":"https://inspirehep.net/api/authors/1026819"},"full_name":"Sillanpaa, A.","signature_block":"SALANPa"}],"curated":false,"texkeys":["MAGIC:2007qzl","Bastieri:2007xi"],"citeable":true,"imprints":[{"date":"2007-07-09"}],"abstracts":[{"value":"The MAGIC Collaboration is building a clone, MAGIC II, of the current MAGIC Telescope. MAGIC II will be built at 85 m of distance from MAGIC I, and will also feature a huge reflecting surface of ~240 m^2 of area. Unlike the former telescope, the mirrors for the new one are lighter and larger, being square of 1 m of side and weighting 10\\u00f712 kg. For the development and production of the new mirrors, two different techniques, both reliable and affordable in price, were tested. We present a description of these two techniques and the performance of the resulting mirrors.","source":"INDICO"},{"value":"The MAGIC Collaboration is building a second telescope, MAGIC II, improving the design of the current MAGIC Telescope. MAGIC II is being built at 85 m of distance from MAGIC I, and will also feature a huge reflecting surface of ~240 m$^2$ of area. One of the improvement is the design for the mirror of MAGIC II, that are lighter and larger, being square of 1 m of side and weighting around 15 kg. For the development and production of the new mirrors, two different techniques, both reliable and affordable in price, were selected: the diamond milling of aluminium surfaces and the cold slumping of thin glass panes. As tests for the second one are still ongoing, we present a description of the diamond milling technique, and its application and performance to the produced mirrors.","source":"arXiv"}],"references":[{"reference":{"misc":["on behalf of the MAGIC Collaboration, Status of the second phase of the MAGIC telescope, these proceedings"],"label":"1","authors":[{"full_name":"F., Goebel"}]}},{"reference":{"misc":["The Mirrors for the MAGIC Telescopes, Proc. of 29th ICRC, Pune, : 5 (2005) 283"],"label":"2","authors":[{"full_name":"D., Bastieri"}]}}],"arxiv_eprints":[{"value":"0709.1372","categories":["astro-ph"]}],"document_type":["conference paper"],"preprint_date":"2007-09","collaborations":[{"value":"MAGIC","record":{"$ref":"https://inspirehep.net/api/experiments/1110626"}}],"control_number":760370,"legacy_version":"20160325232801.0","number_of_pages":4,"inspire_categories":[{"term":"Astrophysics"}],"legacy_creation_date":"2007-09-10","accelerator_experiments":[{"record":{"$ref":"https://inspirehep.net/api/experiments/1110626"},"legacy_name":"MAGIC"}],"external_system_identifiers":[{"value":"2008ICRC....3.1547B","schema":"ADS