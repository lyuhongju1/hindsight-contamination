ehep.net/api/authors/1188359"},"full_name":"Zsigmond, A.J.","signature_block":"ZSAGNADa"},{"uuid":"11bdaf6e-c0db-469f-a640-e9a2242a7c41","record":{"$ref":"https://inspirehep.net/api/authors/981928"},"full_name":"Zuber, K.","signature_block":"ZABARk"},{"uuid":"b40f7ab0-5633-455f-ba2b-7cbefb9caeda","record":{"$ref":"https://inspirehep.net/api/authors/1029734"},"full_name":"Zuzel, G.","signature_block":"ZASALg"}],"curated":true,"license":[{"url":"http://creativecommons.org/licenses/by/4.0/","license":"CC BY 4.0","material":"preprint"}],"texkeys":["LEGEND:2021bnm"],"citeable":true,"keywords":[{"value":"activity report","schema":"INSPIRE"},{"value":"proposed experiment","schema":"INSPIRE"},{"value":"double-beta decay: (0neutrino)","schema":"INSPIRE"},{"value":"mass: Majorana","schema":"INSPIRE"},{"value":"germanium: detector","schema":"INSPIRE"},{"value":"germanium: nuclide","schema":"INSPIRE"},{"value":"sensitivity","schema":"INSPIRE"},{"value":"energy resolution","schema":"INSPIRE"},{"value":"detector: design","schema":"INSPIRE"}],"abstracts":[{"value":"We propose the construction of LEGEND-1000, the ton-scale Large Enriched Germanium Experiment for Neutrinoless $\\beta \\beta$ Decay. This international experiment is designed to answer one of the highest priority questions in fundamental physics. It consists of 1000 kg of Ge detectors enriched to more than 90% in the $^{76}$Ge isotope operated in a liquid argon active shield at a deep underground laboratory. By combining the lowest background levels with the best energy resolution in the field, LEGEND-1000 will perform a quasi-background-free search and can make an unambiguous discovery of neutrinoless double-beta decay with just a handful of counts at the decay $Q$ value. The experiment is designed to probe this decay with a 99.7%-CL discovery sensitivity in the $^{76}$Ge half-life of $1.3\\times10^{28}$ years, corresponding to an effective Majorana mass upper limit in the range of 9-21 meV, to cover the inverted-orde